@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="min-h-[70vh] flex items-center justify-center bg-surface py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl border border-gray-100 p-8">
        <div class="text-center mb-8">
            <h2 class="text-3xl font-extrabold text-primary">Yeni Hesap Oluştur</h2>
            <p class="mt-2 text-sm text-gray-500">Zaten üye misiniz? <a href="/Auth/Login" class="text-secondary font-bold hover:underline">Giriş Yapın</a></p>
        </div>
        
        <form id="registerForm" class="space-y-5">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-primary mb-1">Adınız</label>
                    <input type="text" id="FirstName" required class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-secondary focus:border-secondary h-11 px-3 border outline-none">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-primary mb-1">Soyadınız</label>
                    <input type="text" id="LastName" required class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-secondary focus:border-secondary h-11 px-3 border outline-none">
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-semibold text-primary mb-1">E-posta Adresi</label>
                <input type="email" id="Email" required class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-secondary focus:border-secondary h-11 px-3 border outline-none">
            </div>

            <div>
                <label class="block text-sm font-semibold text-primary mb-1">Şifre</label>
                <input type="password" id="Password" required class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-secondary focus:border-secondary h-11 px-3 border outline-none">
            </div>

            <div id="registerMessage" class="hidden text-sm font-bold text-center p-2 rounded"></div>

            <button type="submit" id="btnRegister" class="w-full flex justify-center py-3 px-4 rounded-lg shadow-md text-sm font-bold text-white bg-secondary hover:bg-opacity-90 transition-all">
                Kayıt Ol
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const apiBaseUrl = "https://localhost:7264/api/Auth/Register";

            $("#registerForm").submit(function(e) {
                e.preventDefault();
                $("#btnRegister").text("Kaydediliyor...").prop("disabled", true);
                $("#registerMessage").addClass("hidden").removeClass("bg-red-100 text-red-600 bg-green-100 text-green-600");
                
                var registerData = {
                    UserName: $("#Email").val(), 
                    FirstName: $("#FirstName").val(),
                    LastName: $("#LastName").val(),
                    Email: $("#Email").val(),
                    Password: $("#Password").val()
                };
                $.ajax({
                    url: apiBaseUrl,
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(registerData),
                    success: function(response) {
                        $("#registerMessage").text("Kayıt başarılı! Giriş sayfasına yönlendiriliyorsunuz...").addClass("bg-green-100 text-green-600").removeClass("hidden");
                        setTimeout(function() {
                            window.location.href = "/Auth/Login";
                        }, 2000);
                    },
                    error: function(xhr) {
                        $("#btnRegister").text("Kayıt Ol").prop("disabled", false);
                        $("#registerMessage").text("Kayıt olurken bir hata oluştu. E-posta kullanımda olabilir.").addClass("bg-red-100 text-red-600").removeClass("hidden");
                    }
                });
            });
        });
    </script>
}