@{
    ViewData["Title"] = "Tüm İlanlar";
}

@section Styles {
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap');

        :root {
            --primary: #0b1c30;
            --secondary: #fe7b29;
            --surface: #f8fafc;
        }

        .ilan-card {
            background: #fff;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid #f0f0f0;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            opacity: 0;
            transform: translateY(24px);
        }

            .ilan-card.visible {
                animation: cardReveal 0.5s ease forwards;
            }

        @@keyframes cardReveal {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .ilan-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 24px 48px rgba(11,28,48,0.12);
        }

        .ilan-img-wrap {
            position: relative;
            height: 220px;
            overflow: hidden;
            background: #e5e7eb;
        }

            .ilan-img-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.6s ease;
            }

        .ilan-card:hover .ilan-img-wrap img {
            transform: scale(1.08);
        }

        .ilan-badge-eids {
            position: absolute;
            top: 14px;
            left: 14px;
            background: rgba(255,255,255,0.92);
            backdrop-filter: blur(8px);
            color: #065f46;
            font-size: 11px;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 99px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .ilan-badge-cat {
            position: absolute;
            top: 14px;
            right: 14px;
            background: #fe7b29;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 99px;
        }

        .ilan-body {
            padding: 20px 22px 22px;
        }

        .ilan-price {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 4px;
        }

        .ilan-title {
            font-family: 'DM Sans', sans-serif;
            font-size: 15px;
            font-weight: 600;
            color: #374151;
            margin-bottom: 8px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .ilan-location {
            font-size: 13px;
            color: #9ca3af;
            display: flex;
            align-items: center;
            gap: 4px;
            margin-bottom: 16px;
        }

        .ilan-meta {
            display: flex;
            gap: 16px;
            padding-top: 14px;
            border-top: 1px solid #f3f4f6;
        }

        .ilan-meta-item {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 13px;
            font-weight: 500;
            color: #6b7280;
            font-family: 'DM Sans', sans-serif;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>
}

<div style="background:var(--surface); min-height: 100vh; padding: 48px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div style="margin-bottom:48px;">
            <p style="color:#fe7b29; font-size:13px; font-weight:700; letter-spacing:0.08em; margin-bottom:10px; font-family:'DM Sans',sans-serif;">KONUTİGO VİTRİN</p>
            <h1 style="font-family:'Playfair Display', serif; font-size: 2.5rem; font-weight: 700; color: var(--primary);">Tüm İlanlar</h1>
        </div>

        <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 mb-8 flex flex-wrap gap-4 items-center">
            <select id="searchCity" class="border border-gray-200 rounded-xl px-4 py-3 text-sm flex-1 min-w-[200px] outline-none focus:border-[#fe7b29]">
                <option value="0">📍 Şehir Seçin</option>
            </select>
            <select id="searchDistrict" disabled class="border border-gray-200 rounded-xl px-4 py-3 text-sm flex-1 min-w-[200px] outline-none focus:border-[#fe7b29]">
                <option value="0">İlçe Seçin</option>
            </select>
            <input type="number" id="searchMaxPrice" placeholder="Maks. Fiyat (₺)" class="border border-gray-200 rounded-xl px-4 py-3 text-sm flex-1 min-w-[200px] outline-none focus:border-[#fe7b29]">
            <button id="btnSearch" class="bg-[#fe7b29] text-white px-8 py-3 rounded-xl font-bold text-sm flex items-center justify-center gap-2 hover:bg-[#e0691f] transition-colors">
                <span class="material-symbols-outlined text-[20px]">search</span> Filtrele
            </button>
        </div>

        <div id="ilanVitrinGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="col-span-full" style="text-align:center; padding:64px 0;">
                <div style="width:40px; height:40px; border:3px solid #fe7b29; border-top-color:transparent; border-radius:50%; animation:spin 0.8s linear infinite; margin:0 auto 16px;"></div>
                <p style="color:#9ca3af; font-family:'DM Sans',sans-serif;">İlanlar yükleniyor...</p>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        const apiBaseUrl = "https://localhost:7264/api";
        const imgBaseUrl = "https://localhost:7264"; // Gerçek resimlerin kök adresi
        const PLACEHOLDER = "https://placehold.co/800x600/eeeeee/999999?text=Gorsel+Yok";

        // 1. Şehirleri yükle
        $.ajax({
        url: apiBaseUrl + "/Location/Cities",
        type: "GET",
        success: function (sehirler) {
        $.each(sehirler, function (i, s) {
        $("#searchCity").append(`<option value="${s.id}">${s.name}</option>`);
        });
        },
        error: function (xhr, status, error) {
        console.log("Şehirler yüklenemedi:", error);
        }
        });

        // 2. Şehir seçilince ilçeleri getir
        $("#searchCity").change(function () {
        let cityId = $(this).val();
        if (cityId == "0") {
        $("#searchDistrict").empty().append('<option value="0">İlçe Seçin</option>').prop("disabled", true);
        return;
        }
        $("#searchDistrict").prop("disabled", false).empty().append('<option value="0">Yükleniyor...</option>');
        $.ajax({
        url: apiBaseUrl + "/Location/Districts/" + cityId,
        type: "GET",
        success: function (ilceler) {
        $("#searchDistrict").empty().append('<option value="0">İlçe Seçin</option>');
        $.each(ilceler, function (i, ilce) {
        $("#searchDistrict").append(`<option value="${ilce.id}">${ilce.name}</option>`);
        });
        },
        error: function (xhr, status, error) {
        console.log("İlçeler yüklenemedi:", error);
        }
        });
        });

        // 3. İlanları Çeken Ana Fonksiyon
        function ilanlariGetir(url) {
        $("#ilanVitrinGrid").html(`
        <div class="col-span-full" style="text-align:center; padding:64px 0;">
        <div style="width:40px; height:40px; border:3px solid #fe7b29; border-top-color:transparent; border-radius:50%; animation:spin 0.8s linear infinite; margin:0 auto 16px;"></div>
        <p style="color:#9ca3af; font-family:'DM Sans',sans-serif;">İlanlar yükleniyor...</p>
        </div>`);

        $.ajax({
        url: url,
        type: "GET",
        success: function (ilanlar) {
        $("#ilanVitrinGrid").empty();

        if (!ilanlar || ilanlar.length === 0) {
        $("#ilanVitrinGrid").html(`<div class="col-span-full text-center py-16" style="color:#9ca3af; font-family:'DM Sans',sans-serif;">Kriterlere uygun ilan bulunamadı.</div>`);
        return;
        }

        $.each(ilanlar, function (i, ilan) {
        let fiyat = new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY', maximumFractionDigits: 0 }).format(ilan.price);
        let tarih = new Date(ilan.createdDate).toLocaleDateString('tr-TR');

        // 🚀 KAPAK FOTOSU MANTIĞI: Picsum yerine gerçek API verisi
        let imageUrls = ilan.imageUrls || ilan.ImageUrls || [];
        let coverImg = (imageUrls && imageUrls.length > 0) ? (imgBaseUrl + imageUrls[0]) : PLACEHOLDER;

        let kart = `
        <div class="ilan-card" style="cursor:pointer;" onclick="window.location.href='/Listing/Detail/${ilan.id}'">
        <div class="ilan-img-wrap">
        <img src="${coverImg}" alt="${ilan.title}" loading="lazy" onerror="this.src='${PLACEHOLDER}'" style="width: 100%; height: 100%; object-fit: cover;">
        <div class="ilan-badge-eids">
        <span class="material-symbols-outlined text-[14px]">verified</span> EİDS Onaylı
        </div>
        <div class="ilan-badge-cat">${ilan.categoryName}</div>
        </div>
        <div class="ilan-body">
        <div class="ilan-price">${fiyat}</div>
        <div class="ilan-title">${ilan.title}</div>
        <div class="ilan-location">
        <span class="material-symbols-outlined text-[16px]">location_on</span>
        ${ilan.cityName} / ${ilan.districtName}
        </div>
        <div class="ilan-meta">
        <div class="ilan-meta-item">
        <span class="material-symbols-outlined text-[16px]">king_bed</span> ${ilan.roomCount}
        </div>
        <div class="ilan-meta-item">
        <span class="material-symbols-outlined text-[16px]">calendar_month</span> ${tarih}
        </div>
        </div>
        </div>
        </div>`;

        $("#ilanVitrinGrid").append(kart);
        });

        // Scroll reveal
        const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
        }, { threshold: 0.1 });
        document.querySelectorAll('.ilan-card').forEach(c => observer.observe(c));
        },
        error: function (xhr, status, error) {
        console.log("HATA DETAYI:", xhr);
        $("#ilanVitrinGrid").html(`
        <div class="col-span-full text-center py-10" style="color:#dc2626; font-family:'DM Sans',sans-serif; font-weight:600;">
        Sunucuya bağlanılamadı! API'nin (Port: 7264) çalıştığından emin olun.<br>
        <small style="font-weight:400; color:#6b7280;">Hata: ${error}</small>
        </div>`);
        }
        });
        }

        // 4. Filtreleme Butonu
        $("#btnSearch").click(function () {
        let cityId = $("#searchCity").val();
        let districtId = $("#searchDistrict").val();
        let maxPrice = $("#searchMaxPrice").val();

        let url = apiBaseUrl + "/Advertisement/Filter?";
        if (cityId != "0") url += "cityId=" + cityId + "&";
        if (districtId != "0") url += "districtId=" + districtId + "&";
        if (maxPrice) url += "maxPrice=" + maxPrice;

        ilanlariGetir(url);
        });

        // 5. Sayfa Yüklendiğinde
        $(document).ready(function () {
        ilanlariGetir(apiBaseUrl + "/Advertisement/Filter");
        });
    </script>
}