@{
    ViewData["Title"] = "İlan Detayı";
}

<style>
    .property-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        grid-template-rows: repeat(2, minmax(200px, 240px));
        gap: 12px;
        min-height: 480px;
    }

    @@media (max-width: 768px) {
        .property-grid {
            grid-template-columns: 1fr;
            grid-template-rows: 300px repeat(4, 150px);
            min-height: auto;
        }
    }
</style>

<main class="max-w-[1280px] mx-auto px-4 sm:px-8 py-12">
    <div id="imgModal" class="fixed inset-0 bg-black/90 z-[999] hidden items-center justify-center cursor-pointer transition-opacity duration-300 opacity-0">
        <span class="absolute top-4 right-6 text-white text-5xl font-bold hover:text-gray-300 transition-colors">&times;</span>
    
        <img class="max-w-[90%] max-h-[90%] object-contain rounded-lg shadow-2xl transition-transform duration-300 scale-90" id="modalImg">
    </div>
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-6">
        <div>
            <nav class="flex items-center gap-1 text-gray-500 text-sm mb-2 font-semibold">
                <span>Satılık</span>
                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                <span id="bcCategory">Yükleniyor...</span>
                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                <span id="bcCity">Yükleniyor...</span>
                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                <span id="bcDistrict">Yükleniyor...</span>
            </nav>
            <h1 id="adTitle" class="text-3xl sm:text-4xl font-extrabold text-[#00112d]">İlan Yükleniyor...</h1>
            <div class="flex items-center gap-2 mt-2 text-gray-600">
                <span class="material-symbols-outlined text-[18px]">location_on</span>
                <span id="adFullLocation" class="text-base">Konum Yükleniyor...</span>
            </div>
        </div>
        <div class="flex gap-3">
            <button class="flex items-center gap-2 border border-gray-300 px-4 py-2 rounded-lg hover:bg-gray-50 transition-all text-[#00112d]">
                <span class="material-symbols-outlined text-[20px]">share</span>
                <span class="text-sm font-semibold">Paylaş</span>
            </button>
            <button class="flex items-center gap-2 border border-gray-300 px-4 py-2 rounded-lg hover:bg-gray-50 transition-all text-[#00112d]">
                <span class="material-symbols-outlined text-[20px]">favorite</span>
                <span class="text-sm font-semibold">Kaydet</span>
            </button>
        </div>
    </div>

    <section id="imageGallery" class="property-grid mb-12 rounded-xl overflow-hidden shadow-sm bg-gray-100">
        <div class="row-span-2 flex items-center justify-center text-gray-400">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-[#9e4300]"></div>
        </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

        <div class="lg:col-span-8">
            <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 mb-8">
                <div class="flex flex-wrap justify-between items-center mb-8 border-b border-gray-100 pb-6">
                    <div>
                        <p class="text-gray-500 text-sm font-semibold mb-1">Satış Fiyatı</p>
                        <h2 id="adPrice" class="text-[#00112d] font-extrabold text-[40px]">...</h2>
                    </div>
                    <div class="flex gap-6 mt-6 sm:mt-0">
                        <div class="text-center px-6">
                            <span class="material-symbols-outlined text-[#9e4300] block mb-1">bed</span>
                            <p id="adRoom" class="text-2xl font-semibold">...</p>
                            <p class="text-sm text-gray-500">Oda</p>
                        </div>
                        <div class="text-center px-6 border-x border-gray-200">
                            <span class="material-symbols-outlined text-[#9e4300] block mb-1">square_foot</span>
                            <p id="adSquare" class="text-2xl font-semibold">...</p>
                            <p class="text-sm text-gray-500">m² Brüt</p>
                        </div>
                        <div class="text-center px-6">
                            <span class="material-symbols-outlined text-[#9e4300] block mb-1">apartment</span>
                            <p id="adFloor" class="text-2xl font-semibold">...</p>
                            <p class="text-sm text-gray-500">Kat</p>
                        </div>
                    </div>
                </div>

                <h3 class="text-2xl font-bold text-[#00112d] mb-4">İlan Açıklaması</h3>
                <div id="adDescription" class="space-y-4 text-gray-600 leading-relaxed">
                    <p>Yükleniyor...</p>
                </div>

                <h3 class="text-2xl font-bold text-[#00112d] mt-12 mb-6">Özellikler</h3>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-6">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#9e4300]">check_circle</span>
                        <span class="text-base text-gray-700">Bina Yaşı: <b id="fAge">...</b></span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#9e4300]">check_circle</span>
                        <span class="text-base text-gray-700">Isıtma: <b id="fHeating">...</b></span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#9e4300]">check_circle</span>
                        <span class="text-base text-gray-700">Eşyalı: <b id="fFurnished">...</b></span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#9e4300]">check_circle</span>
                        <span class="text-base text-gray-700">Taşınmaz No: <b id="fTasinmaz">...</b></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-4">
            <div class="sticky top-24 space-y-6">
                <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100">
                    <div class="flex items-center gap-6 mb-8">
                        <div class="w-16 h-16 rounded-full bg-gray-200 flex items-center justify-center text-[#9e4300]">
                            <span class="material-symbols-outlined text-3xl">person</span>
                        </div>
                        <div>
                            <h4 id="adSeller" class="text-xl font-bold text-[#00112d]">Yükleniyor...</h4>
                            <p class="text-sm text-gray-500 mt-1">İlan Sahibi / Danışman</p>
                        </div>
                    </div>
                    <div class="space-y-3">
                        <button class="w-full bg-[#00112d] text-white py-3 rounded-lg font-semibold hover:bg-opacity-90 transition-all flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">call</span>
                            Numarayı Göster
                        </button>
                        <button class="w-full border-2 border-[#00112d] text-[#00112d] py-3 rounded-lg font-semibold hover:bg-gray-50 transition-all flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">mail</span>
                            Mesaj Gönder
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(document).ready(function () {
        var adId = @ViewBag.AdId;
        var apiBaseUrl = "https://localhost:7264/api/Advertisement/";
            
        // Son yaptığımız doğru ayar: Sadece ana adres
        var imgBaseUrl = "https://localhost:7264";
        var PLACEHOLDER = "https://placehold.co/800x600/eeeeee/999999?text=Gorsel+Yok";

        // İlan Detaylarını Çek
        $.ajax({
        url: apiBaseUrl + adId,
        type: "GET",
        success: function (data) {
        var title            = data.title            || data.Title            || "Başlıksız İlan";
        var desc             = data.description      || data.Description      || "Bu ilan için henüz bir açıklama girilmemiştir.";
        var price            = data.price            || data.Price            || 0;
        var roomCount        = data.roomCount        || data.RoomCount        || "-";
        var squareMeter      = data.squareMeter      || data.SquareMeter      || "-";
        var floor            = data.floorNumber      || data.FloorNumber      || "-";
        var cityName         = data.cityName         || data.CityName         || "Belirtilmemiş";
        var districtName     = data.districtName     || data.DistrictName     || "Belirtilmemiş";
        var neighborhoodName = data.neighborhoodName || data.NeighborhoodName || "Belirtilmemiş";
        var categoryName     = data.categoryName     || data.CategoryName     || "Kategori";
        var buildingAge      = data.buildingAge      || data.BuildingAge      || "-";
        var heating          = data.heatingType      || data.HeatingType      || "-";
        var isFurnished      = data.isFurnished      !== undefined ? data.isFurnished : data.IsFurnished;
        var tasinmazNo       = data.tasinmazNo       || data.TasinmazNo       || "Belirtilmemiş";
        var seller           = data.sellerFullName   || data.SellerFullName   || "Konutigo Danışmanı";

        var imageUrls = data.imageUrls || data.ImageUrls || [];

        // Metinleri ata
        $("#adTitle").text(title);
        var safeDesc = String(desc).replace(/\n/g, "<br>");
        $("#adDescription").html(`<p>${safeDesc}</p>`);
        var priceFormat = new Intl.NumberFormat("tr-TR", { style: "currency", currency: "TRY", maximumFractionDigits: 0 }).format(price);
        $("#adPrice").text(priceFormat);
        $("#adRoom").text(roomCount);
        $("#adSquare").text(squareMeter);
        $("#adFloor").text(floor);
        $("#bcCategory").text(categoryName);
        $("#bcCity").text(cityName);
        $("#bcDistrict").text(districtName);
        $("#adFullLocation").text(`${neighborhoodName}, ${districtName}, ${cityName}`);
        $("#fAge").text(buildingAge);
        $("#fHeating").text(heating);
        $("#fFurnished").text(isFurnished ? "Evet" : "Hayır");
        $("#fTasinmaz").text(tasinmazNo);
        $("#adSeller").text(seller);

        // GALERİ DÖNGÜSÜ
        var galleryHtml = "";
        var slotCount = 5;

        for (var i = 0; i < slotCount; i++) {
        var imgUrl = (imageUrls && imageUrls.length > i && imageUrls[i])
        ? (imgBaseUrl + imageUrls[i])
        : PLACEHOLDER;

        if (i === 0) {
        galleryHtml += `
        <div class="relative group cursor-pointer overflow-hidden row-span-2 rounded-xl w-full h-full bg-gray-100 shadow">
        <img src="${imgUrl}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" onerror="this.src='${PLACEHOLDER}'" />
        </div>`;
        } else {
        var overlay = "";
        if (i === 4 && imageUrls.length > 5) {
        overlay = `
        <div class="absolute inset-0 bg-[#00112d]/50 flex items-center justify-center transition-all duration-300 hover:bg-[#00112d]/30">
        <span class="text-white font-bold text-xl drop-shadow-md">+${imageUrls.length - 5} Fotoğraf</span>
        </div>`;
        }
        galleryHtml += `
        <div class="relative group cursor-pointer overflow-hidden rounded-xl w-full h-full bg-gray-100 shadow">
        <img src="${imgUrl}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" onerror="this.src='${PLACEHOLDER}'" />
        ${overlay}
        </div>`;
        }
        }

        $("#imageGallery").html(galleryHtml);
        },
        error: function () {
        $("#adTitle").text("İlan Bulunamadı veya Yayından Kaldırılmış!");
        $("#imageGallery").html(`
        <div class="row-span-2 col-span-3 flex items-center justify-center bg-gray-200 rounded-xl text-gray-500 flex-col py-20">
        <span class="material-symbols-outlined text-6xl mb-2">broken_image</span>
        <p>Görseller Yüklenemedi</p>
        </div>`);
        }
        });

        // ========================================================
        // 🚀 [YENİ] Büyüteç (Lightbox) Mantığı
        // ========================================================

        // 1. Resimler AJAX ile dinamik yüklendiği için parent elemente (#imageGallery) dinleyici takıyoruz.
        $('#imageGallery').on('click', 'img', function() {
        // Tıklanan resmin src'sini al
        var clickedImgSrc = $(this).attr('src');
                
        // Eğer tıklandığında placeholder varsa büyütme (Gerek yoksa silebilirsin)
        if(clickedImgSrc === PLACEHOLDER) return;

        // Modal içindeki resme bu src'yi ata
        $('#modalImg').attr('src', clickedImgSrc);
                
        // Modalı aç (hidden'ı kaldır, flex yap) ve animasyonları tetikle
        $('#imgModal').removeClass('hidden').addClass('flex');
                
        // Ufak bir gecikme ile animasyonu başlat (scale ve opacity)
        setTimeout(() => {
        $('#imgModal').removeClass('opacity-0').addClass('opacity-100');
        $('#modalImg').removeClass('scale-90').addClass('scale-100');
        }, 10);
        });

        // 2. Modalı Kapatma Mantığı (Arka plana veya X'e basınca)
        $('#imgModal, #imgModal span').click(function(e) {
        // Eğer tıklandığında hedef resmin kendisi DEĞİLSE (arka plansa veya X ise) kapat
        if (e.target !== $('#modalImg')[0]) {
        $('#imgModal').removeClass('opacity-100').addClass('opacity-0');
        $('#modalImg').removeClass('scale-100').addClass('scale-90');
                    
        // Animasyon bittikten (300ms) sonra tamamen gizle
        setTimeout(() => {
        $('#imgModal').removeClass('flex').addClass('hidden');
        }, 300);
        }
        });

        // 3. Klavye ile Kapatma Mantığı (Esc'ye basınca)
        $(document).keydown(function(e) {
        if (e.key === "Escape" && !$('#imgModal').hasClass('hidden')) {
        $('#imgModal, #imgModal span').click(); // Kapatma mantığını tetikle
        }
        });
        });
    </script>
}