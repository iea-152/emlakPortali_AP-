@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="mb-8 flex justify-between items-end">
    <div>
        <h1 class="text-2xl font-extrabold text-primary">Sistem Kullanıcıları</h1>
        <p class="text-gray-500 text-sm mt-1">Sisteme kayıtlı tüm üyeleri görüntüleyin ve yönetin.</p>
    </div>
    <div class="hidden sm:block">
        <button onclick="window.location.href='/Auth/Register'" class="bg-secondary text-white px-5 py-2.5 rounded-xl text-sm font-bold shadow-md hover:bg-opacity-90 transition-all flex items-center">
            <span class="material-symbols-outlined text-[18px] mr-2">person_add</span> Yeni Kullanıcı Ekle
        </button>
    </div>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="p-5 border-b border-gray-100 flex flex-wrap gap-4 items-center justify-between bg-gray-50/50">
        <div class="relative">
            <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-400 text-sm">search</span>
            <input type="text" id="userSearch" placeholder="İsim veya e-posta ara..." class="pl-9 pr-4 py-2 border-gray-200 rounded-xl text-sm focus:ring-secondary focus:border-secondary w-72">
        </div>
        <div class="flex gap-2 text-sm">
            <button id="btnFilterAll" class="px-4 py-2 bg-secondary text-white border border-secondary rounded-lg font-semibold transition-all shadow-sm">Tümü</button>
            <button id="btnFilterActive" class="px-4 py-2 bg-white border border-gray-200 rounded-lg text-gray-600 hover:text-primary font-semibold transition-all shadow-sm">Aktifler</button>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-white border-b border-gray-100">
                    <th class="px-6 py-4 text-xs font-extrabold text-gray-400 uppercase tracking-wider">Kullanıcı Bilgisi</th>
                    <th class="px-6 py-4 text-xs font-extrabold text-gray-400 uppercase tracking-wider">Kullanıcı Adı</th>
                    <th class="px-6 py-4 text-xs font-extrabold text-gray-400 uppercase tracking-wider">Durum</th>
                    <th class="px-6 py-4 text-xs font-extrabold text-gray-400 uppercase tracking-wider text-right">Aksiyonlar</th>
                </tr>
            </thead>
            <tbody id="usersTableBody" class="divide-y divide-gray-50">
                <tr>
                    <td colspan="4" class="px-6 py-12 text-center text-gray-400">
                        <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-secondary mb-4"></div>
                        <p>Kullanıcılar yükleniyor...</p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const apiBaseUrl = "https://localhost:7264/api/Auth/Users";
            const token = localStorage.getItem("token");

            // Kullanıcı girişi kontrolü
            if (!token) {
                window.location.href = "/Auth/Login";
                return;
            }

            // 1. Kullanıcıları API'den Çekme
            window.loadUsers = function() {
                $.ajax({
                    url: apiBaseUrl,
                    type: "GET",
                    headers: { "Authorization": "Bearer " + token },
                    success: function (data) {
                        const tbody = $("#usersTableBody");
                        tbody.empty();

                        if (data.length === 0) {
                            tbody.append(`<tr><td colspan="4" class="px-6 py-8 text-center text-gray-500">Sistemde henüz kayıtlı kullanıcı yok.</td></tr>`);
                            return;
                        }

                        $.each(data, function (index, user) {
                            let initials = (user.firstName.charAt(0) + user.lastName.charAt(0)).toUpperCase();
                            let isAdmin = user.email.includes("admin") ?
                                '<span class="bg-primary text-white text-[10px] px-2 py-0.5 rounded ml-2 font-bold uppercase">Admin</span>' : '';

                            // ASP.NET Identity ID'leri GUID (metin) olduğu için tırnak içine alıyoruz
                            let userId = user.id;

                            let row = `
                                <tr class="hover:bg-gray-50/80 transition-colors group" id="user-row-${userId}">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-4">
                                            <div class="h-10 w-10 flex-shrink-0 rounded-full bg-secondary/10 text-secondary flex items-center justify-center font-bold">
                                                ${initials}
                                            </div>
                                            <div>
                                                <div class="text-sm font-bold text-primary flex items-center">
                                                    ${user.firstName} ${user.lastName} ${isAdmin}
                                                </div>
                                                <div class="text-xs text-gray-500 mt-0.5">${user.email}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600 font-medium">
                                        ${user.userName}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="bg-green-50 text-green-600 border border-green-200 px-3 py-1 rounded-full text-xs font-bold flex w-max items-center">
                                            <span class="w-1.5 h-1.5 bg-green-500 rounded-full mr-1.5"></span> Aktif
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right font-medium">
                                        <button onclick="viewUserDetails('${user.firstName} ${user.lastName}', '${user.email}', '${user.userName}')" class="text-primary hover:bg-gray-100 p-2 rounded-lg transition-colors border border-transparent hover:border-gray-200" title="Detayları Gör">
                                            <span class="material-symbols-outlined text-sm">visibility</span>
                                        </button>
                                        <button onclick="deleteUser('${userId}', '${user.firstName} ${user.lastName}')" class="text-red-500 hover:bg-red-50 p-2 rounded-lg transition-colors border border-transparent hover:border-red-100 ml-1" title="Kullanıcıyı Sil">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                        </button>
                                    </td>
                                </tr>
                            `;
                            tbody.append(row);
                        });
                    },
                    error: function (xhr) {
                        $("#usersTableBody").html(`<tr><td colspan="4" class="px-6 py-8 text-center text-red-500 font-bold">Kullanıcılar yüklenirken bir hata oluştu. Yetkinizi kontrol edin.</td></tr>`);
                    }
                });
            }

            // Sayfa açıldığında kullanıcıları yükle
            loadUsers();

            // 2. Arama (Filtreleme) İşlemi
            $("#userSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#usersTableBody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            // 3. Tümü ve Aktifler Butonları Görsel Geçişi
            $("#btnFilterAll, #btnFilterActive").click(function() {
                $("#btnFilterAll, #btnFilterActive").removeClass("bg-secondary text-white border-secondary").addClass("bg-white text-gray-600 border-gray-200");
                $(this).removeClass("bg-white text-gray-600 border-gray-200").addClass("bg-secondary text-white border-secondary");
            });
        });

        // 4. Kullanıcı Detaylarını Gösterme Fonksiyonu (SweetAlert)
        window.viewUserDetails = function(fullName, email, username) {
            Swal.fire({
                title: 'Kullanıcı Bilgileri',
                html: `
                    <div style="text-align: left; padding: 10px; line-height: 1.8;">
                        <b>Ad Soyad:</b> ${fullName} <br/>
                        <b>Kullanıcı Adı:</b> @@${username} <br/>
                        <b>E-Posta:</b> ${email} <br/>
                        <b>Durum:</b> Aktif
                    </div>
                `,
                icon: 'info',
                confirmButtonColor: '#0b1c30',
                confirmButtonText: 'Kapat'
            });
        };

        // 5. Kullanıcıyı Silme/Engelleme Fonksiyonu
        window.deleteUser = function(userId, fullName) {
            const token = localStorage.getItem("token");
            
            Swal.fire({
                title: 'Emin misiniz?',
                text: `${fullName} adlı kullanıcıyı sistemden tamamen silmek istediğinize emin misiniz? Bu işlem geri alınamaz!`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Evet, Sil!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "https://localhost:7264/api/Auth/Users/" + userId,
                        type: "DELETE",
                        headers: { "Authorization": "Bearer " + token },
                        success: function () {
                            Swal.fire('Silindi!', `${fullName} sistemden başarıyla silindi.`, 'success');
                            // Kullanıcıyı tablodan yavaşça kaydırarak sil
                            $(`#user-row-${userId}`).fadeOut(400, function() { $(this).remove(); });
                        },
                        error: function (xhr) {
                            let errorMsg = xhr.responseJSON ? xhr.responseJSON.message : 'Kullanıcı silinirken bir hata oluştu. (Admin hesabı silinemez vb.)';
                            Swal.fire('Hata', errorMsg, 'error');
                        }
                    });
                }
            });
        };
    </script>
}