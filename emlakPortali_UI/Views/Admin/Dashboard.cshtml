@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="mb-8">
    <h1 class="text-2xl font-extrabold text-primary">Hoş Geldiniz, Yönetici</h1>
    <p class="text-gray-500 text-sm mt-1">İşte Konutigo emlak portalınızın bugünkü özeti.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group">
        <div class="flex justify-between items-start mb-4">
            <span class="text-sm font-bold text-gray-500">Toplam İlan</span>
            <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-xl">domain</span>
            </div>
        </div>
        <h3 class="text-3xl font-extrabold text-primary mb-2" id="statTotalListings">Yükleniyor...</h3>
        <p class="text-xs font-bold text-green-500 flex items-center">
            <span class="material-symbols-outlined text-[14px] mr-1">trending_up</span> +4.2% geçen aydan
        </p>
        <div class="absolute bottom-0 left-0 w-full h-1 bg-blue-500"></div>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group">
        <div class="flex justify-between items-start mb-4">
            <span class="text-sm font-bold text-gray-500">Onay Bekleyenler</span>
            <div class="w-10 h-10 bg-red-50 text-red-600 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-xl">pending_actions</span>
            </div>
        </div>
        <h3 class="text-3xl font-extrabold text-primary mb-2" id="statPending">Yükleniyor...</h3>
        <p class="text-xs font-bold text-red-500 flex items-center">
            <span class="material-symbols-outlined text-[14px] mr-1">warning</span> Aksiyon gerekli
        </p>
        <div class="absolute bottom-0 left-0 w-full h-1 bg-red-500"></div>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group">
        <div class="flex justify-between items-start mb-4">
            <span class="text-sm font-bold text-gray-500">Aktif Üyeler</span>
            <div class="w-10 h-10 bg-orange-50 text-secondary rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-xl">group</span>
            </div>
        </div>
        <h3 class="text-3xl font-extrabold text-primary mb-2" id="statUsers">450</h3>
        <p class="text-xs font-bold text-green-500 flex items-center">
            <span class="material-symbols-outlined text-[14px] mr-1">trending_up</span> +12.5% geçen aydan
        </p>
        <div class="absolute bottom-0 left-0 w-full h-1 bg-secondary"></div>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group">
        <div class="flex justify-between items-start mb-4">
            <span class="text-sm font-bold text-gray-500">Aylık Trafik</span>
            <div class="w-10 h-10 bg-purple-50 text-purple-600 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-xl">visibility</span>
            </div>
        </div>
        <h3 class="text-3xl font-extrabold text-primary mb-2">12.4K</h3>
        <p class="text-xs font-bold text-green-500 flex items-center">
            <span class="material-symbols-outlined text-[14px] mr-1">trending_up</span> +8.1% geçen aydan
        </p>
        <div class="absolute bottom-0 left-0 w-full h-1 bg-purple-500"></div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-lg font-bold text-primary">Piyasa Trendleri (İlan Hacmi)</h3>
            <select class="text-sm border-gray-200 rounded-lg text-gray-600 focus:ring-secondary focus:border-secondary">
                <option>Bu Ay</option>
                <option>Geçen Ay</option>
                <option>Bu Yıl</option>
            </select>
        </div>
        <div class="h-72 bg-gray-50 rounded-xl border border-dashed border-gray-200 flex flex-col items-center justify-center text-gray-400">
            <span class="material-symbols-outlined text-4xl mb-2">bar_chart</span>
            <span class="text-sm font-medium">Grafik verileri API'den yüklenecek...</span>
        </div>
    </div>

    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-lg font-bold text-primary">İlan Yayınlama Trendi</h3>
            <span class="text-xs font-semibold text-gray-400">Son 6 Ayın Verileri</span>
        </div>
        <div class="h-72 relative">
            <canvas id="trendsChart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const apiBaseUrl = "https://localhost:7264/api/Advertisement";
            const token = localStorage.getItem("token");
            $.ajax({
                url: apiBaseUrl + "/Pending",
                type: "GET",
                headers: { "Authorization": "Bearer " + token },
                success: function(pendingData) {
                    
                    $("#statPending").text(pendingData.length);
                    if(pendingData.length > 0) {
                        $("#pendingBadge").text(pendingData.length).removeClass("hidden");
                    } else {
                        $("#pendingBadge").addClass("hidden");
                    }
                    let recentItems = pendingData.slice(0, 4); 
                    $("#recentPendingList").empty();
                    
                    if(recentItems.length === 0) {
                        $("#recentPendingList").append('<div class="text-center py-8 text-gray-400 text-sm">Bekleyen ilan yok.</div>');
                    } else {
                        $.each(recentItems, function(i, item) {
                            let priceFormat = new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY', maximumFractionDigits: 0 }).format(item.price);
                            let html = `
                                <div class="flex items-center gap-3 p-3 hover:bg-gray-50 rounded-xl transition-colors border border-transparent hover:border-gray-100 cursor-pointer">
                                    <div class="w-12 h-12 rounded-lg bg-gray-200 flex-shrink-0 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1560518883-ce09059eeffa?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80')"></div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-bold text-primary truncate">${item.title}</p>
                                        <p class="text-xs text-gray-500 truncate">${item.cityName} - ${item.categoryName}</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm font-extrabold text-secondary">${priceFormat}</p>
                                    </div>
                                </div>
                            `;
                            $("#recentPendingList").append(html);
                        });
                    }
                },
                error: function(xhr) {
                    console.error("Bekleyen ilanlar çekilemedi:", xhr);
                    $("#statPending").text("Hata");
                }
            });
            $.ajax({
                url: apiBaseUrl + "/ApprovedList",
                type: "GET",
                success: function(approvedData) {
                    $("#statTotalListings").text(approvedData.length);
                },
                error: function() {
                    $("#statTotalListings").text("0");
                }
            });

        });
    </script>
}
